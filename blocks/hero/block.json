{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "starter/hero",
  "title": "Hero",
  "description": "En-tête de page : grand titre, texte et bouton, puis une grande image aux coins arrondis.",
  "category": "starter",
  "icon": "cover-image",
  "keywords": ["bannière", "en-tête", "header"],
  "textdomain": "starter",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    }
  },
  "example": {},
  "acf": {
    "blockVersion": 3,
    "mode": "preview",
    "renderTemplate": "render.php"
  }
}
