{
  // Tri des classes Tailwind (A → Z) à chaque enregistrement d'un fichier PHP ou JS.
  // Nécessite l'extension « Run on Save » (emeraldwalk.RunOnSave). Voir docs/build.md.
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.(php|js)$",
        "notMatch": "/(node_modules|dist|build)/",
        "isAsync": true,
        "cmd": "node \"${workspaceFolder}/bin/sort-classes.mjs\" \"${file}\""
      }
    ]
  },

  // Prettier à l'enregistrement pour JS, CSS, JSON, Markdown.
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // PHP : règles WordPress (phpcs.xml.dist). Erreurs soulignées pendant la frappe,
  // corrections automatiques (PHPCBF) à l'enregistrement. Le HTML des gabarits n'est
  // pas réindenté (aucun outil ne le fait proprement). Nécessite `composer install`.
  "phpCodeSniffer.standard": "Automatic",
  "phpCodeSniffer.autoExecutable": true,
  "[php]": {
    "editor.defaultFormatter": "obliviousharmony.vscode-php-codesniffer",
    "editor.formatOnSave": true
  },
  // Le formateur d'Intelephense (style PSR-12) casserait le style WordPress.
  "intelephense.format.enable": false,

  // Autocomplétion Tailwind dans le PHP aussi.
  "tailwindCSS.includeLanguages": { "php": "html" },
  "tailwindCSS.experimental.configFile": "assets/src/css/main.css"
}
