{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "duotone": [],
      "gradients": [],
      "palette": [
        {
          "slug": "primary",
          "name": "Principale",
          "color": "#3E3852"
        },
        {
          "slug": "secondary",
          "name": "Secondaire (lavande)",
          "color": "#D6CCF5"
        },
        {
          "slug": "dark",
          "name": "Foncé",
          "color": "#1C1C1C"
        },
        {
          "slug": "light",
          "name": "Clair",
          "color": "#ECEAE6"
        },
        {
          "slug": "paper",
          "name": "Fond",
          "color": "#FAF9F7"
        },
        {
          "slug": "white",
          "name": "Blanc",
          "color": "#ffffff"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Texte (Figtree)",
          "fontFamily": "'Figtree', ui-sans-serif, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Figtree",
              "fontWeight": "300 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/figtree.woff2"
              ]
            }
          ]
        },
        {
          "slug": "heading",
          "name": "Titres (Onest)",
          "fontFamily": "'Onest', ui-sans-serif, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Onest",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/onest.woff2"
              ]
            }
          ]
        },
        {
          "slug": "accent",
          "name": "Accent (italique, citations)",
          "fontFamily": "ui-serif, Georgia, Cambria, 'Times New Roman', serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Petit",
          "size": "0.875rem"
        },
        {
          "slug": "base",
          "name": "Normal",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Grand",
          "size": "1.25rem"
        },
        {
          "slug": "x-large",
          "name": "Très grand",
          "size": "1.875rem"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": false,
      "spacingSizes": [],
      "units": [
        "px",
        "rem",
        "%"
      ]
    },
    "shadow": {
      "defaultPresets": false
    },
    "layout": {
      "contentSize": "48rem",
      "wideSize": "80rem"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "lineHeight": "1.5"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--dark)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "9999px"
        },
        "typography": {
          "fontWeight": "500"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)"
          }
        }
      }
    }
  }
}
