{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "starter/notice",
  "title": "Encadré",
  "description": "Message court mis en avant, dans une pilule centrée avec une étiquette : information, succès ou attention.",
  "category": "starter",
  "icon": "info",
  "keywords": [
    "alerte",
    "info",
    "message"
  ],
  "textdomain": "starter",
  "attributes": {
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning"
      ],
      "default": "info"
    },
    "badge": {
      "type": "string",
      "default": ""
    },
    "content": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "example": {
    "attributes": {
      "type": "info",
      "badge": "30 min",
      "content": "Premier rendez-vous <strong>offert</strong> : on fait le point sur votre projet en 30 minutes."
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}