{
  "name": "wordpress-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run blocks:build",
    "blocks:dev": "wp-scripts start --webpack-src-dir=blocks-native/src --output-path=blocks-native/build --webpack-copy-php",
    "blocks:build": "wp-scripts build --webpack-src-dir=blocks-native/src --output-path=blocks-native/build --webpack-copy-php",
    "format": "prettier --write . && node bin/sort-classes.mjs",
    "format:check": "prettier --check . && node bin/sort-classes.mjs --check",
    "lint:php": "composer lint",
    "lint:php:fix": "composer lint:fix",
    "pot": "wp i18n make-pot . languages/starter.pot --slug=starter --domain=starter --exclude=vendor,node_modules,dist,blocks-native/build,demo"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@wordpress/scripts": "^37.2.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
