  "scripts": {
    "dev": "vite",
    "dev:blocks": "wp-scripts start --webpack-src-dir=blocks/src --output-path=blocks/build",
    "build": "vite build && npm run build:blocks",
    "build:blocks": "wp-scripts build --webpack-src-dir=blocks/src --output-path=blocks/build",
    "sort-classes": "rustywind --write .",
    "format": "rustywind --write . && prettier --write ."
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.25.0",
